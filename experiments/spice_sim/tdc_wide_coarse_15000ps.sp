.options reltol=1e-3 abstol=1e-12 vntol=1e-4 chgtol=1e-16 method=gear temp=25
.control
tran 0.1ns 60ns uic
meas tran coarse_q0_val FIND v(coarse_q0) AT=55n
meas tran coarse_q1_val FIND v(coarse_q1) AT=55n
meas tran coarse_q2_val FIND v(coarse_q2) AT=55n
meas tran coarse_q3_val FIND v(coarse_q3) AT=55n
